# Ignore everything that would make the Docker build slow
node_modules/
.git/
.dev-data/
.worktrees/
.act/
.venv/
__pycache__/
*.pyc
dist/
.vscode/
apps/momai/bin/
apps/momai/dist/
apps/core/.venv/
*.db

# Security — environment files
.env*
!**/.env.example

# Security — secrets and certificates
secrets/
certs/

# Security — certificate/key files
*.pfx
*.p12
*.key
*.pem
*.crt
*.cert

# Logs
logs/
*.log
