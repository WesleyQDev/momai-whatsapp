# Normalize line endings to LF for text files, CRLF for Windows-specific files
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.webm binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.pdf binary
*.dll binary
*.exe binary
*.node binary
