# Auto-detect text files
* text=auto

# Shell scripts MUST use LF (bash dies on CRLF)
*.sh text eol=lf

# PowerShell scripts use CRLF (Windows convention)
*.ps1 text eol=crlf

# Keep binary files as-is
*.png binary
*.jpg binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.exe binary
*.dll binary
*.appx binary
*.msix binary
*.pfx binary
