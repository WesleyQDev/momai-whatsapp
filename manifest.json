  "sidebar": true,
  "background": true,
  "backgroundScript": "background-worker.ts",
  "permissions": [
    "network:persistent",
    "storage:persistent"
  ],
  "sdkVersion": 1,
  "momai_compat": ">=1.11.0",
  "ui": {
    "page": "dist/page.js",
    "pageType": "whatsapp-page",
    "panel": "dist/panel.js",
    "panelType": "whatsapp-panel"
  },
  "eventTypes": {
    "qr_code": {
      "label": "Novo QR Code Gerado"
    },
    "authenticated": {
      "label": "WhatsApp Autenticado"
    },
    "connection_status": {
      "label": "Status da Conexão Alterado"
    },
    "contacts_synced": {
      "label": "Contatos Sincronizados"
    },
    "contacts_updated": {
      "label": "Contatos Atualizados"
    },
    "history_loaded": {
      "label": "Histórico Carregado"
    },
    "whatsapp_message": {
      "label": "Mensagem Recebida no WhatsApp",
      "priority": 100,
      "fields": {
        "contact": {
          "label": "Remetente (Contato ou Grupo)",
          "type": "string",
          "description": "Filtra mensagens de um contato ou grupo específico",
          "x-options-source": {
            "tool": "list_contacts"
          }
        },
        "message": {
          "label": "Palavra-chave na Mensagem",
          "type": "string",
          "description": "Dispara quando a mensagem contiver este texto"
        },
        "timestamp": {
          "label": "Horário",
          "type": "number"
        },
        "imageDataUri": {
          "label": "Imagem / Mídia",
          "type": "image"
        }
      }
    },
    "whatsapp_notification": {
      "label": "Notificação do WhatsApp"
    },
    "message_sent": {
      "label": "Mensagem Enviada"
    }
  },
  "tools": [
    {
      "name": "send_message",
      "label": "Enviar Mensagem no WhatsApp",
      "description": "Envia uma mensagem para um contato ou grupo do WhatsApp. Pode incluir uma imagem (data URI ou base64) com o texto como legenda.",
      "parameters": {
        "type": "object",
        "required": [
          "contact",
          "message"
        ],
        "properties": {
          "contact": {
            "type": "string",
            "description": "Nome ou número do contato ou grupo",
            "x-options-source": {
              "tool": "list_contacts"
            }
          },
          "message": {
            "type": "string",
            "description": "Texto da mensagem"
          },
          "image": {
            "type": "string",
            "description": "Imagem a enviar (data URI como data:image/jpeg;base64,... ou base64 puro). O texto vira a legenda.",
            "default": "{event.imageDataUri}"
          },
          "documents": {
            "type": "array",
            "description": "Documentos a enviar (PDF, Word, Excel, etc.). Cada item pode ser objeto { dataUrl, fileName, mimetype } ou data URI."
          }
        }
      }
    },
    {
      "name": "set_default_contact",
      "description": "Define o contato padrão para preencher o campo 'para quem' das actions.",
      "parameters": {
        "type": "object",
        "required": [
          "contact"
        ],
        "properties": {
          "contact": {
            "type": "string",
            "description": "Nome ou número do contato padrão"
          }
        }
      }
    },
    {
      "name": "get_default_contact",
      "description": "Retorna o contato padrão configurado.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_contacts",
      "description": "Lista os contatos monitorados no WhatsApp",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "add_contact",
      "description": "Adiciona um contato ou grupo para monitoramento",
      "parameters": {
        "type": "object",
        "required": [
          "contact"
        ],
        "properties": {
          "contact": {
            "type": "string",
            "description": "Número do contato ou ID do grupo"
          }
        }
      }
    },
    {
      "name": "remove_contact",
      "description": "Remove um contato ou grupo do monitoramento",
      "parameters": {
        "type": "object",
        "required": [
          "contact"
        ],
        "properties": {
          "contact": {
            "type": "string",
            "description": "Número ou ID do contato"
          }
        }
      }
    },
    {
      "name": "set_contact_name",
      "description": "Define um nome personalizado para um contato (melhora o contexto do LLM)",
      "parameters": {
        "type": "object",
        "required": [
          "contact",
          "name"
        ],
        "properties": {
          "contact": {
            "type": "string",
            "description": "Número do contato"
          },
          "name": {
            "type": "string",
            "description": "Nome personalizado"
          }
        }
      }
    },
    {
      "name": "sync_contacts",
      "description": "Força uma re-sincronização dos contatos do WhatsApp com o telefone. Use quando os contatos estiverem ausentes, incompletos ou desatualizados. Retorna a quantidade de contatos após a sincronização.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_avatars",
      "description": "Busca fotos de perfil para uma lista de JIDs (contatos ou grupos)",
      "parameters": {
        "type": "object",
        "required": [
          "jids"
        ],
        "properties": {
          "jids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Lista de JIDs WhatsApp (@s.whatsapp.net ou @g.us)"
          }
        }
      }
    },
    {
      "name": "open_document",
      "description": "Abre um documento recebido no aplicativo padrão do computador (Word para .docx, Acrobat/navegador para .pdf)",
      "parameters": {
        "type": "object",
        "required": [
          "filename"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "description": "Nome do arquivo salvo (campo document do evento)"
          },
          "documentName": {
            "type": "string",
            "description": "Nome original para exibição (campo documentName do evento)"
          }
        }
      }
    },
    {
      "name": "get_stats",
      "description": "Obtém estatísticas do WhatsApp",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_history",
      "description": "Obtém histórico de mensagens recentes",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_wa_contacts",
      "description": "Lista os contatos do WhatsApp importados do telefone.",
      "parameters": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "description": "Busca por nome ou número (opcional)"
          }
        }
      }
    },
    {
      "name": "get_wa_groups",
      "description": "Lista os grupos do WhatsApp sincronizados.",
      "parameters": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "description": "Busca por nome do grupo (opcional)"
          },
          "page": {
            "type": "number",
            "description": "Página (opcional)"
