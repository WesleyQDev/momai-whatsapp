                                                   "summary":  "Smart Notifications",
                                                   "privacy":  "Security \u0026 Privacy"
                                               }
                                 },
                   "examples":  {
                                    "title":  "Examples of what you can ask",
                                    "items":  {
                                                  "send":  "Send a WhatsApp message to Mom saying I\u0027m on my way.",
                                                  "check":  "Any new messages on WhatsApp?",
                                                  "reply":  "Reply that I\u0027ll be there soon.",
                                                  "add":  "Add my mom to the WhatsApp whitelist."
                                              }
                                },
                   "connection":  {
                                      "title":  "How to connect",
                                      "steps":  {
                                                    "open":  "Enable the extension in the extension store.",
                                                    "phone":  "Scan the QR Code that appears in the sidebar panel using WhatsApp on your phone.",
                                                    "scan":  "Done! MomAI is now connected and monitoring your whitelisted contacts.",
                                                    "done":  "Select the contacts you want to monitor and enjoy the ease of chatting from your computer."
                                                }
                                  },
                   "privacy":  {
                                   "title":  "Security \u0026 Privacy",
                                   "description":  "The connection is made locally on your computer via Baileys. No messages go through external servers — everything stays between your PC and WhatsApp. Only contacts added to the whitelist are monitored."
                               }
