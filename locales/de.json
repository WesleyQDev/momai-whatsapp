                "contacts": "Überwacht Nachrichten",
                "voice": "Sendet Antworten",
                "nicknames": "Verwaltet Kontakte",
                "summary": "Intelligente Benachrichtigungen",
                "privacy": "Sicherheit & Datenschutz"
            }
        },
        "examples": {
            "title": "Beispiele, wonach du fragen kannst",
            "items": {
                "send": "Sende eine WhatsApp-Nachricht an Mama, dass ich auf dem Weg bin.",
                "check": "Gibt es neue Nachrichten auf WhatsApp?",
                "reply": "Antworte, dass ich bald da bin.",
                "add": "Füge meine Mama zur WhatsApp-Whitelist hinzu."
            }
        },
        "connection": {
            "title": "So verbindest du dich",
            "steps": {
                "open": "Aktiviere die Erweiterung im Erweiterungs-Store.",
                "phone": "Scanne den QR Code, der im Seitenpanel erscheint, mit WhatsApp auf deinem Handy.",
                "scan": "Fertig! MomAI ist jetzt verbunden und überwacht deine Whitelist-Kontakte.",
                "done": "Wähle die Kontakte aus, die du überwachen möchtest, und genieße das Chatten vom Computer aus."
            }
        },
        "privacy": {
            "title": "Sicherheit & Datenschutz",
            "description": "Die Verbindung erfolgt lokal auf deinem Computer über Baileys. Keine Nachrichten laufen über externe Server — alles bleibt zwischen deinem PC und WhatsApp. Nur Kontakte auf der Whitelist werden überwacht."
        }
