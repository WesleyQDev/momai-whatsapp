FROM node:20-bookworm

# System deps for Electron Linux builds (same as release.yml)
RUN apt-get update && apt-get install -y \
  libgtk-3-dev \
  libnotify-dev \
  libnss3 \
  libxss1 \
  libxtst6 \
  xvfb \
  rpm \
  fakeroot \
  dos2unix \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm

WORKDIR /workspace


