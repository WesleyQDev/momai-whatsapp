FROM node:20-bookworm

RUN apt-get update && apt-get install -y \
  libgtk-3-dev libnotify-dev libnss3 libxss1 libxtst6 \
  xvfb rpm fakeroot \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm

WORKDIR /app

# Deps definition (rarely changes → cached in layer)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/momai/package.json apps/momai/electron-builder.yml apps/momai/

# Install deps (cached unless lockfile changes)
RUN pnpm install --no-frozen-lockfile --filter momai

# Source code (changes often)
COPY . .

# Set version and build
ARG VERSION
RUN cd apps/momai && pnpm version "$VERSION" --no-git-tag-version --allow-same-version
RUN pnpm --filter momai build:linux
